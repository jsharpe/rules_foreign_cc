cc_binary(
    name = "make",
    deps = [":_make"],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "_make",
    defines = ["LOCALEDIR=\\\"locale\\\"","LIBDIR=\\\"lib\\\""],
    srcs = glob(["lib/*.h"]) + [
        "@rules_foreign_cc//toolchains:config.h",
	"src/ar.c",
	"src/arscan.c",
	"src/commands.c",
	"src/commands.h",
	"src/debug.h", 
	"src/default.c",
	"src/dep.h",
	"src/dir.c",
	"src/expand.c",
	"src/file.c",
	"src/filedef.h",
	"src/function.c",
	"src/getopt.c",
	"src/getopt.h", 
	"src/getopt1.c",
	"src/gettext.h",
	"src/guile.c",
	"src/hash.c",
	"src/hash.h",
	"src/implicit.c",
	"src/job.c",
	"src/job.h",
	"src/load.c",
	"src/loadapi.c",
	"src/main.c",
	"src/makeint.h",
	"src/misc.c",
	"src/os.h",
	"src/output.c",
	"src/output.h",
	"src/read.c",
	"src/remake.c",
	"src/rule.c", 
	"src/rule.h",
	"src/shuffle.h",
	"src/shuffle.c",
	"src/signame.c",
	"src/strcache.c",
	"src/variable.c",
	"src/variable.h",
	"src/version.c",
	"src/vpath.c",
	"src/remote-stub.c",
	"lib/findprog-in.c",
	"lib/concat-filename.c",
    ] + select({
       "@platforms//os:linux": ["src/posixos.c"],
       "//conditions:default": [],       
       }),
    copts = ["-Iexternal/gnumake_src/lib", "-Iexternal/gnumake_src/src", "-Itoolchains"],
    linkopts = ["-ldl"],
)
